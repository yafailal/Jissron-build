# =============================================================
# AILearn — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================

# --- Database (Supabase / Neon / any PostgreSQL) ---
# Use the Supabase POOLER url (port 6543) here — for the app at runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the DIRECT connection url (port 5432) here — for db push / migrate only
# In Supabase: Project Settings → Database → Connection string → URI (NOT the pooler)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- NextAuth.js v5 ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- LinkedIn OAuth (optional — provider is only enabled when both are set) ---
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# --- Resend (magic-link email + transactional email) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@ailearn.com"

# --- UploadThing v7 (file uploads) ---
UPLOADTHING_TOKEN="eyJhcGlLZXkiOi..."

# --- Bunny Stream (course video hosting, signed embed URLs) ---
BUNNY_STREAM_LIBRARY_ID="your-library-id"
BUNNY_STREAM_API_KEY="your-stream-api-key"
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxxxx-xxx.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY="your-token-auth-key"
