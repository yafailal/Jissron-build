# =============================================================
# JissrON — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================

# --- Database (Supabase / Neon / any PostgreSQL) ---
# Use the Supabase POOLER url (port 6543) here — for the app at runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Use the DIRECT connection url (port 5432) here — for db push / migrate only
# In Supabase: Project Settings → Database → Connection string → URI (NOT the pooler)
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# --- NextAuth.js v5 ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Resend (magic-link email + transactional email) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@jissron.com"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- UploadThing (file uploads) ---
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-uploadthing-app-id"
