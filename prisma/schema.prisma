generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")     // pooler URL — used by the app at runtime
  directUrl = env("DIRECT_URL")       // direct connection — used by db push / migrate
}

// ============== AUTH & USERS ==============

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  bio             String?
  isFeatured      Boolean    @default(false)
  featuredTagline String?
  badges          String[]   @default([])
  // Permissions — admins always pass; instructors need explicit grants.
  canHostLive     Boolean    @default(false)
  // Revenue share: PLATFORM's cut of paid course revenue (instructor gets the rest), in whole percent.
  platformCutPercent Int     @default(30)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  accounts Account[]
  sessions Session[]

  // as instructor
  coursesTeaching Course[]
  liveSessions    LiveSession[]
  consultant      Consultant?

  // as student
  enrollments            Enrollment[]
  orders                 Order[]
  bookings               Booking[]
  consultBookings        ConsultBooking[]
  reviews                Review[]
  quizAttempts           QuizAttempt[]
  assignmentSubmissions  AssignmentSubmission[]
  lessonQuestions        LessonQuestion[]
  lessonQuestionReplies  LessonQuestionReply[]
  certificates           Certificate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============== SITE SETTINGS (singleton) ==============

model SiteSettings {
  id String @id @default("default")

  // Brand
  siteName    String  @default("JissrON")
  tagline     String  @default("Learning Management System | EdTech Platform")
  logoUrl     String?
  logoDarkUrl String?
  faviconUrl  String?

  // Colors (hex, admin-overridable)
  defaultCurrency    String @default("MAD")

  colorPrimary       String @default("#003d80")
  colorPrimaryHover  String @default("#0058b8")
  colorPrimaryBright String @default("#0071e3")
  colorInk           String @default("#081a36")
  colorBg            String @default("#ffffff")
  colorBorder        String @default("#e4e9ef")

  // Nav
  navLinks Json @default("[]") // [{label, url}]

  // Hero section
  heroKicker            String @default("12,482 learners joined this week")
  heroTitleLine1        String @default("Learn anything.")
  heroTitleLine2        String @default("Live, on-demand,")
  heroTitleLine3        String @default("or one-on-one.")
  heroSubtitle          String @default("Master new skills with 1,200+ expert-led courses, weekly live sessions, and private mentorship.")
  heroSearchPlaceholder String @default("What do you want to learn today?")
  heroPopularTerms      Json   @default("[\"Python\", \"Excel\", \"ChatGPT\", \"Design\", \"Data Analytics\"]")
  heroTrustBullets      Json   @default("[\"30-day money-back\", \"Certificates of completion\", \"Learn at your own pace\"]")

  // Urgency banner
  urgencyEnabled  Boolean   @default(true)
  urgencyTag      String    @default("FLASH SALE")
  urgencyMessage  String    @default("Courses from $9.99")
  urgencyEndsAt   DateTime?
  urgencyCtaLabel String    @default("Shop now →")
  urgencyCtaUrl   String    @default("#")

  // Trust strip
  trustStripLabel String @default("Trusted by learners at the world's leading companies")
  trustStripLogos Json   @default("[]")

  // Mid-CTA banner
  midCtaTitle          String @default("Unlock every course with JissrON Plus")
  midCtaDescription    String @default("Get unlimited access to all courses, live sessions, and priority booking.")
  midCtaPrimaryLabel   String @default("Start 7-day free trial")
  midCtaPrimaryUrl     String @default("/pricing")
  midCtaSecondaryLabel String @default("See plans & pricing")
  midCtaSecondaryUrl   String @default("/pricing")
  midCtaStats          Json     @default("[]")
  midCtaCourseIds      String[] @default([])

  // Final CTA
  finalCtaTitle       String @default("Start learning for free today")
  finalCtaDescription String @default("Join 2.4M learners growing their skills.")
  finalCtaCtaLabel    String @default("Get started free")
  finalCtaCtaUrl      String @default("/auth/signin")

  // Footer
  footerColumns   Json   @default("[]")
  footerSocial    Json   @default("[]")
  footerCopyright String @default("© JissrON Inc.")

  // Contact — surfaced on /contact and used as the destination for the
  // contact form. Phone/WhatsApp/address are display-only.
  supportEmail   String @default("")
  supportPhone   String @default("")
  supportWhatsapp String @default("")
  supportAddress String @default("")

  // Global SEO defaults
  seoTitle       String  @default("JissrON — Learning Management System")
  seoDescription String?
  seoOgImageUrl  String?

  // Bank transfer (MAD) — configured via admin UI, never seeded
  bankName         String? @default("")
  bankAccountName  String? @default("")
  bankIBAN         String? @default("")
  bankRIB          String? @default("")
  bankSwift        String? @default("")
  bankInstructions String? @db.Text

  // Stripe (international USD card payments via Stripe Checkout).
  // Env vars (STRIPE_SECRET_KEY etc.) take precedence over these fields in production.
  stripeEnabled        Boolean @default(false)
  stripeSecretKey      String?
  stripePublishableKey String?
  stripeWebhookSecret  String?

  // CMI — Moroccan card acquiring (hosted payment page). Configure once the
  // merchant account is provisioned. Test mode points at testpayment.cmi.co.ma.
  cmiEnabled    Boolean @default(false)
  cmiTestMode   Boolean @default(true)
  cmiMerchantId String?
  cmiStoreKey   String?

  // Legal
  cookieConsentEnabled Boolean @default(true)

  // System
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ============== COURSES ==============

enum LessonType {
  VIDEO
  AUDIO
  TEXT
  PDF
  HTML
  QUIZ
  ASSIGNMENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentMethod {
  FREE
  BANK_TRANSFER
  CMI
  STRIPE
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  courses      Course[]
  liveSessions LiveSession[]
  consultants  Consultant[]
}

model Course {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  subtitle        String?
  description     String       @db.Text
  thumbnailUrl    String?
  previewVideoUrl String?
  level           CourseLevel  @default(BEGINNER)
  status          CourseStatus @default(DRAFT)
  priceCents      Int          @default(0)
  oldPriceCents   Int?
  durationMinutes Int          @default(0)
  language        String       @default("en")

  priceMadCents    Int  @default(0)
  priceUsdCents    Int  @default(0)
  oldPriceMadCents Int?
  oldPriceUsdCents Int?

  badge        String?
  isBestseller Boolean @default(false)
  isFeatured   Boolean @default(false)

  // Stripe Price ID for USD Checkout (e.g. "price_1Abc…"). Required to expose
  // the Stripe payment option on this course.
  stripePriceId String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id])

  modules      Module[]
  enrollments  Enrollment[]
  orders       Order[]
  reviews      Review[]
  faqs         CourseFAQ[]
  certificates Certificate[]

  seoTitle       String?
  seoDescription String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model CourseFAQ {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([courseId])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id              String     @id @default(cuid())
  moduleId        String
  title           String
  type            LessonType @default(VIDEO)
  videoUrl        String?
  audioUrl        String?
  pdfUrl          String?
  htmlContent     String?    @db.Text
  textContent     String?    @db.Text
  durationSeconds Int        @default(0)
  order           Int
  isPreview       Boolean    @default(false)
  transcript      String?    @db.Text

  videoGuid      String?  // Bunny Stream video GUID — primary field for VIDEO lessons (used to generate signed embed URLs)
  quizId         String? @unique
  assignmentId   String? @unique

  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress   LessonProgress[]
  quiz       Quiz?            @relation(fields: [quizId], references: [id])
  assignment Assignment?      @relation(fields: [assignmentId], references: [id])
  questions  LessonQuestion[]
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  NONE          // free enrollments
  BANK_TRANSFER // Moroccan MAD customers (manual bank transfer)
  CMI           // Moroccan MAD card payments via CMI hosted page
  STRIPE        // international USD card payments via Stripe Checkout
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Exactly one of {courseId, liveSessionId, consultBookingId} must be set.
  // App layer is responsible for enforcement; nullable here lets the same Order model power all three revenue sources.
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  liveSessionId  String?
  liveSession    LiveSession?  @relation(fields: [liveSessionId], references: [id], onDelete: Restrict)
  consultBookingId String?     @unique
  consultBooking ConsultBooking? @relation(fields: [consultBookingId], references: [id], onDelete: Restrict)
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod @default(NONE)
  amountCents    Int
  currency       String        // "MAD" | "USD"
  orderReference String?       @unique
  receiptUrl     String?
  adminNote      String?       @db.Text
  // CMI gateway tracking — populated when paymentMethod == CMI
  cmiTransactionId String?     @unique
  cmiResponseRaw   Json?       // last callback body for debugging / audit
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  expiredAt      DateTime?
  updatedAt      DateTime      @updatedAt

  // Instructor payout — null = the instructor's share for this order hasn't been transferred yet
  instructorPayoutAt DateTime?

  enrollments    Enrollment[]

  @@index([userId])
  @@index([courseId])
  @@index([liveSessionId])
  @@index([status])
  @@index([instructorPayoutAt])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  orderId     String?
  // TODO: method is deprecated in favor of Order.paymentMethod — remove in a future cleanup pass
  method      EnrollmentMethod @default(FREE)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  expiresAt   DateTime?        // null = lifetime access (default)
  progressPct Int              @default(0)
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order    Order?           @relation(fields: [orderId], references: [id])
  progress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  watchedSecs  Int      @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// ============== LIVE SESSIONS ==============

enum LiveSessionKind {
  AMA
  WORKSHOP
  SEMINAR
  COHORT
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveSession {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  description  String            @db.Text
  kind         LiveSessionKind
  status       LiveSessionStatus @default(SCHEDULED)
  startsAt     DateTime
  durationMins Int               @default(60)
  seatsTotal   Int               @default(50)
  priceCents   Int               @default(0)
  meetingUrl    String?
  recordingUrl  String?
  priceMadCents Int               @default(0)
  priceUsdCents Int               @default(0)
  isFree        Boolean           @default(false)
  isFeatured    Boolean           @default(false)
  language      String            @default("en")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  hostId String
  host   User   @relation(fields: [hostId], references: [id])

  bookings  Booking[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([categoryId])
}

model Booking {
  id              String    @id @default(cuid())
  userId          String
  liveSessionId   String
  status          String    @default("CONFIRMED")
  createdAt       DateTime  @default(now())
  // Set by the reminder cron once we email the bookee — prevents duplicate sends.
  reminderSentAt  DateTime?

  user        User        @relation(fields: [userId], references: [id])
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id])

  @@unique([userId, liveSessionId])
}

// ============== CONSULTANTS & 1:1 ==============

model Consultant {
  id             String  @id @default(cuid())
  userId         String  @unique
  tagline        String?
  bio            String  @db.Text
  ratePerSession Int
  durationMins   Int     @default(30)
  skills                   String[]
  avatarGradient           String?
  ratePerSessionMadCents   Int     @default(0)
  ratePerSessionUsdCents   Int     @default(0)
  availability             Json    @default("[]")
  totalSessions  Int     @default(0)
  avgRating      Float   @default(0)
  isFeatured     Boolean @default(false)
  acceptsNew     Boolean @default(true)
  language       String  @default("en")
  timezone       String  @default("UTC")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  user     User             @relation(fields: [userId], references: [id])
  bookings ConsultBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ConsultBooking {
  id           String   @id @default(cuid())
  studentId    String
  consultantId String
  scheduledFor DateTime
  durationMins Int      @default(30)
  status       String   @default("CONFIRMED")
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  student    User       @relation(fields: [studentId], references: [id])
  consultant Consultant @relation(fields: [consultantId], references: [id])
  order      Order?
}

// ============== CMS / CONTENT PAGES ==============

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.Text
  category  String  @default("general")
  order     Int     @default(0)
  published Boolean @default(true)
}

// ============== ACTIVITY LOG (audit) ==============

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

// ============== QUIZ ==============

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Quiz {
  id                  String   @id @default(cuid())
  title               String
  description         String?  @db.Text
  passThreshold       Int      @default(70)
  maxRetries          Int      @default(3)
  showCorrectAnswers  Boolean  @default(true)
  shuffleQuestions    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lesson    Lesson?
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  prompt        String       @db.Text
  points        Int          @default(1)
  order         Int
  options       Json         @default("[]")
  correctAnswer String?      @db.Text
  explanation   String?      @db.Text
  createdAt     DateTime     @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Int?
  passed      Boolean?
  answers     Json      @default("[]")

  quiz Quiz @relation(fields: [quizId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

// ============== ASSIGNMENT ==============

model Assignment {
  id               String   @id @default(cuid())
  title            String
  instructions     String   @db.Text
  maxFileSizeMb    Int      @default(10)
  allowedFileTypes String[]
  dueOffsetDays    Int?
  passingGrade     Int      @default(70)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lesson      Lesson?
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  userId       String
  fileUrl      String
  fileName     String
  submittedAt  DateTime  @default(now())
  grade        Int?
  feedback     String?   @db.Text
  gradedAt     DateTime?
  gradedBy     String?
  status       String    @default("SUBMITTED")

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
}

// ============== LESSON Q&A ==============

model LessonQuestion {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  body      String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson  Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies LessonQuestionReply[]

  @@index([lessonId])
  @@index([userId])
}

model LessonQuestionReply {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

// ============== CERTIFICATES ==============
//
// Issued when an enrollment completes (all lessons done). Names + course title
// are SNAPSHOTTED at issue time so a later rename or course-title edit doesn't
// retroactively alter what the certificate attests to.

model Certificate {
  id           String   @id @default(cuid())
  serialNumber String   @unique // public-facing, e.g. "JISS-2026-A7B3C9"
  userId       String
  courseId     String

  // Snapshot at the moment of issue — survives later renames
  studentName    String
  studentEmail   String
  courseTitle    String
  instructorName String

  issuedAt      DateTime  @default(now())
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId]) // one certificate per enrollment
  @@index([userId])
  @@index([courseId])
  @@index([revoked])
}
